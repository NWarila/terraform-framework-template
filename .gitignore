# Default-deny (ADR-0003). Every tracked file MUST be explicitly
# allowlisted below. No wildcard allows. Adding a tracked file requires
# adding its exact path here too — keeps the tracked surface auditable
# at a glance.
**

# ----- [ Repository self-management ] -------------------------------------------------------------
!/.editorconfig
!/.gitattributes
!/.gitignore
!/.markdownlint-cli2.jsonc
!/.pre-commit-config.yaml
!/.terraform-docs.yml
!/.tflint.hcl

# ----- [ Top-level documentation ] ----------------------------------------------------------------
!/README.md
!/LICENSE
!/CODE_OF_CONDUCT.md
!/CONTRIBUTING.md
!/SECURITY.md
!/SUPPORT.md
!/CHANGELOG.md

# ----- [ Release automation ] ---------------------------------------------------------------------
!/release-please-config.json
!/.release-please-manifest.json

# ----- [ Quality gates ] --------------------------------------------------------------------------
!/baseline-manifest.json

# ----- [ Build / quality interface ] --------------------------------------------------------------
!/Makefile

# ----- [ GitHub configuration ] -------------------------------------------------------------------
!/.github/
!/.github/CODEOWNERS
!/.github/PULL_REQUEST_TEMPLATE.md
!/.github/renovate.json5
!/.github/workflows/
!/.github/workflows/auto-merge.yaml
!/.github/workflows/codeql.yaml
!/.github/workflows/drift-gate.yaml
!/.github/workflows/release-evidence.yaml
!/.github/workflows/release-please.yaml
!/.github/workflows/reusable-auto-merge.yaml
!/.github/workflows/reusable-codeql.yaml
!/.github/workflows/reusable-iac-security.yaml
!/.github/workflows/reusable-release-evidence.yaml
!/.github/workflows/reusable-release-please.yaml
!/.github/workflows/reusable-scorecard.yaml
!/.github/workflows/reusable-terraform-deploy.yaml
!/.github/workflows/scorecard.yaml
!/.github/workflows/security.yaml
!/.github/workflows/self-ci.yaml

# ----- [ OPA policies ] ---------------------------------------------------------------------------
!/policies/
!/policies/opa/
!/policies/opa/golden_terraform.rego
!/policies/opa/golden_terraform_test.rego

# ----- [ Tooling ] --------------------------------------------------------------------------------
!/tools/
!/tools/build_opa_input.py
!/tools/check_docs_layout.py
!/tools/ci/
!/tools/ci/config.toml
!/tools/ci/run_integration.py

# ----- [ Documentation (Diátaxis + decision-records) ] --------------------------------------------
!/docs/
!/docs/README.md
!/docs/tutorials/
!/docs/tutorials/.gitkeep
!/docs/how-to/
!/docs/how-to/.gitkeep
!/docs/how-to/develop-this-module.md
!/docs/reference/
!/docs/reference/.gitkeep
!/docs/reference/invariants.md
!/docs/reference/release-gates.md
!/docs/reference/terraform.md
!/docs/explanation/
!/docs/explanation/.gitkeep
!/docs/explanation/architecture.md
!/docs/explanation/testing-strategy.md
!/docs/explanation/threat-model.md
!/docs/decision-records/
!/docs/decision-records/README.md
!/docs/decision-records/org/
!/docs/decision-records/org/.gitkeep
!/docs/decision-records/org/0001-use-architecture-decision-records.md
!/docs/decision-records/org/0002-adopt-diataxis-documentation-framework.md
!/docs/decision-records/org/0003-use-deny-all-gitignore-strategy.md
!/docs/decision-records/org/0004-use-renovate-for-dependency-updates.md
!/docs/decision-records/template/
!/docs/decision-records/template/.gitkeep
!/docs/decision-records/repo/
!/docs/decision-records/repo/.gitkeep

# ----- [ Terraform module ] -----------------------------------------------------------------------
!/terraform/
!/terraform/versions.tf
!/terraform/providers.tf
!/terraform/backend.tf
!/terraform/data.tf
!/terraform/variables.tf
