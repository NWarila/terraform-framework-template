# Default-deny (ADR-0003). Every tracked file or intentionally tracked
# directory subtree MUST be explicitly allowlisted below. Directory
# entries use ADR-0003's directory-plus-contents pair so the tracked
# surface stays auditable at a glance.
**

# ----- [ Repository self-management ] -------------------------------------------------------------
!/.editorconfig
!/.gitattributes
!/.gitignore
!/.markdownlint-cli2.jsonc
!/.pre-commit-config.yaml
!/.terraform-docs.yml
!/.tflint.hcl

# ----- [ Top-level documentation ] ----------------------------------------------------------------
!/README.md
!/LICENSE
!/CODE_OF_CONDUCT.md
!/CONTRIBUTING.md
!/SECURITY.md
!/SUPPORT.md
!/CHANGELOG.md

# ----- [ Release automation ] ---------------------------------------------------------------------
!/release-please-config.json
!/.release-please-manifest.json

# ----- [ Quality gates ] --------------------------------------------------------------------------
!/baseline-manifest.json

# ----- [ Build / quality interface ] --------------------------------------------------------------
!/Makefile

# ----- [ GitHub configuration ] -------------------------------------------------------------------
!/.github/
!/.github/CODEOWNERS
!/.github/PULL_REQUEST_TEMPLATE.md
!/.github/renovate.json5
!/.github/workflows/
!/.github/workflows/auto-merge.yaml
!/.github/workflows/ci.yaml
